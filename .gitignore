# Python and tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Everything the app generates at runtime: papers, narrations, the TTS clip cache, uploads,
# voice samples and designed voices. Large, personal, and re-creatable.
data/

# Third-party paper copies used as test fixtures (arXiv's licence doesn't allow redistribution).
# tests/conftest.py downloads the PDF/HTML from arXiv; the OCR output is made locally.
tests/fixtures/*.pdf
tests/fixtures/*.html
tests/fixtures/*.part
tests/fixtures/ocr_raw_*.json

# Secrets and local configuration
.env
.env.*
*.pem
*.key
*.p12
auth.json
credentials*.json
secrets*

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
